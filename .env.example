# Base URL of the MyIPL .NET backend (Vite inlines this into the client bundle).
#
# Local dev: copy to `.env` (or `.env.local`) — points at the ASP.NET Core dev server.
VITE_API_URL=http://localhost:5288
#
# Production: put your Railway API domain in `.env.production` (auto-loaded by
# `npm run build`), e.g.
#   VITE_API_URL=https://myipl-api-production.up.railway.app
